# Copy to .env and adjust before deploy. Secrets have no defaults on purpose.
#   cp .env.example .env

# ---- Public URL (everything derives from this) ----
DOMAIN=maxit.mini.pw.edu.pl

# ---- Secrets (no defaults — real values delivered separately) ----
JWT_SECRET_KEY=
SIGNING_SECRET=
DB_PASSWORD=
QUEUE_PASSWORD=

# ---- Database ----
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_NAME=maxit

# ---- Queue ----
QUEUE_HOST=rabbitmq
QUEUE_PORT=5672
QUEUE_USER=guest

# ---- Backend ----
APP_PORT=8000
COOKIE_SECURE=true

# ---- File storage ----
FILE_STORAGE_HOST=file-storage
FILE_STORAGE_PORT=8080
PUBLIC_SERVER_PORT=8888
INTERNAL_SERVER_PORT=8080
MAX_SIGN_TTL_SECONDS=3600
ROOT_DIRECTORY=/data

# ---- Frontend ----
BODY_SIZE_LIMIT=20M

# ---- Worker ----
DOCKER_HOST=unix:///var/run/docker.sock
JOBS_DATA_VOLUME=maxit_jobs-data
RESPONSE_QUEUE_NAME=worker_response_queue
WORKER_QUEUE_NAME=worker_queue
